# Copy this file to `.env` (in this same FinalProject/ folder) and fill in
# real values. `.env` is git-ignored. Docker Compose reads it for the api and
# database services.

# --- Postgres ---
# These configure the postgres container on first init and are also read by
# the API's database connection.
POSTGRES_USER=pwprotector
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=pw_protector

# --- API database connection ---
# DB_HOST must be the compose service name; DB_PORT is the in-container port.
DB_HOST=database
DB_PORT=5432

# --- API app config ---
PORT=80
# Secret used to sign JWTs. Use a long random string.
API_SECRET_KEY=change_me_to_a_long_random_secret
# Set to "production" to enable Secure cookies (requires HTTPS). Leave unset
# for local http development.
# NODE_ENV=production
